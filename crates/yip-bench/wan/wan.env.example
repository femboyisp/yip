# WAN benchmark host pair — copy to `wan.env` (git-ignored) and fill in.
# The suite is host-agnostic: point it at any two Linux boxes with root SSH-key
# access. Node A drives the benchmarks; node B runs the tunnel/iperf endpoints.

# Node A (the driver) and node B (the responder): public IPs or resolvable hosts.
# (Example values from RFC 5737 documentation ranges — replace with your hosts.)
HOST_A=203.0.113.10
HOST_B=198.51.100.20

# Optional human-readable labels used in the committed RESULTS.md instead of
# raw IPs (leave unset to fall back to the IPs). Handy for not publishing infra.
HOST_A_LABEL="VPS-A (region A)"
HOST_B_LABEL="VPS-B (region B)"

# SSH user + private key used for BOTH hosts (key-based auth only).
SSH_USER=root
SSH_KEY=$HOME/.ssh/id_ed25519

# UDP ports for each tunnel's outer transport (must be free on both hosts).
YIP_PORT=51833
WG_PORT=51834
OVPN_PORT=51835

# Common overlay MTU applied to all three tunnels for an apples-to-apples test.
OVERLAY_MTU=1380
