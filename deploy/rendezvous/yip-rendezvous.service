[Unit]
Description=Yip Mesh Rendezvous and Blind Relay Daemon
Documentation=https://yipmesh.tech https://github.com/femboyisp/yip
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yip-rendezvous
Group=yip-rendezvous
ExecStart=/usr/local/bin/yip-rendezvous --listen-udp 0.0.0.0:443 --listen-tcp 0.0.0.0:443
Restart=always
RestartSec=3s
LimitNOFILE=65535

# Process security and privilege minimization
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
