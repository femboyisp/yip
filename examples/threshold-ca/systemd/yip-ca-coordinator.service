[Unit]
Description=yip-ca Threshold Coordinator Daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/yip-ca serve --role coordinator --bind 0.0.0.0:4443 --threshold 2 --pubkey /etc/yip/ca/pubkey_package.json
Restart=always
RestartSec=5s
LimitMEMLOCK=infinity
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_IPC_LOCK
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/yip/ca

[Install]
WantedBy=multi-user.target
